FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04

# Install basic runtime tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    libnuma1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Download Aria Energy CMFD v1.0.2 binary
RUN echo "Downloading Aria Energy CMFD v1.0.2..." && \
    curl -fsSL -A "curl/8.5.0" -o miner.tar.gz "https://pub-4bc92882522745e291a08f11119e3205.r2.dev/cmfd-dl/aria-energy-cmfd-v1.0.2-linux-x86_64.tar.gz" && \
    tar -xzf miner.tar.gz --strip-components=1 && \
    chmod +x aria-energy-cmfd get-model.sh && \
    rm -f miner.tar.gz

# Download MODEL-V2.bank (6.4 GB) and verify SHA-256
RUN echo "Downloading MODEL-V2.bank (6.4 GB)..." && \
    curl -fL -A "curl/8.5.0" -C - --retry 10 --retry-delay 5 -o MODEL-V2.bank "https://pub-4bc92882522745e291a08f11119e3205.r2.dev/cmfd-dl/MODEL-V2.bank" && \
    echo "5f9b213c3bda51b74e4ebabb26607b67385d613aa8d99af915a48ab063e17d4e  MODEL-V2.bank" | sha256sum -c -

# Copy instant entrypoint script
COPY entrypoint_cmfd.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh

ENV WALLET="3108d8fb264197e55111430b59863e65fbd0eebd50527825febba5b77cea6cbc"
ENV POOL="cmfd+tls://159.69.194.46:29445?pin=9dfb51083f287726117f689f87bc7a878792efcca58ca8b6f6e7c05ac5d152e9"
ENV NVIDIA_VISIBLE_DEVICES="all"
ENV NVIDIA_DRIVER_CAPABILITIES="all"

ENTRYPOINT ["/workspace/entrypoint.sh"]
